---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
  dark?: boolean;
}

const { stats, dark = false } = Astro.props;
---

<div class:list={['stat-block', { 'stat-block--dark': dark }]}>
  {
    stats.map((s) => (
      <div class="stat-block__cell">
        <div class="stat-block__value">{s.value}</div>
        <div class="stat-block__label">{s.label}</div>
      </div>
    ))
  }
</div>

<style>
  .stat-block {
    display: grid;
    /* auto-fit, not the fixed-column grid the old StatBlock.jsx documented —
       matches how every live page actually lays these out responsively. */
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1px;
    background: var(--color-border);
    max-width: var(--content-max-width);
    width: 100%;
  }
  .stat-block--dark {
    background: rgba(255, 255, 255, 0.15);
  }
  .stat-block__cell {
    background: #fff;
    padding: var(--space-8) var(--space-5);
    text-align: center;
  }
  .stat-block--dark .stat-block__cell {
    background: var(--color-ink);
  }
  .stat-block__value {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: clamp(24px, 2.8vw, 38px);
    color: var(--brand-accent);
    line-height: 1;
  }
  .stat-block--dark .stat-block__value {
    color: var(--color-accent-tint);
  }
  .stat-block__label {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--text-secondary);
    line-height: 1.4;
  }
  .stat-block--dark .stat-block__label {
    color: var(--color-on-dark-muted);
  }
</style>
