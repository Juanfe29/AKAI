---
import { nav, type Lang } from '../i18n/site';

interface Props {
  lang: Lang;
  dark?: boolean;
}

const { lang, dark = false } = Astro.props;
const t = nav[lang];
const base = `/${lang}`;
const year = new Date().getFullYear();
---

<footer class:list={['footer', { 'footer--dark': dark }]}>
  <div class="footer__inner">
    <a href={`${base}/`} class="footer__logo">
      <img src={dark ? '/assets/akai-logo-white.png' : '/assets/akai-logo-dark.png'} alt="AKAI" width="100" height="26" />
    </a>
    <nav class="footer__links" aria-label="Sitemap">
      <a href={`${base}/`}>{t.home}</a>
      <a href={`${base}/vision/`}>{t.vision}</a>
      <a href={`${base}/process/`}>{t.process}</a>
      <a href={`${base}/case-studies/palm/`}>{t.casePalm}</a>
      <a href={`${base}/case-studies/roots/`}>{t.caseRoots}</a>
      <a href={`${base}/technology/`}>{t.technology}</a>
      <a href={`${base}/carbon/`}>{t.carbon}</a>
      <a href={`${base}/track-record/`}>{t.trackRecord}</a>
      <a href={`${base}/team/`}>{t.team}</a>
      <a href={`${base}/contact/`}>{t.contact}</a>
    </nav>
    <p class="footer__copy">&copy; {year} AKAI S.A.S.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-paper);
    border-top: 1px solid var(--color-border);
    padding: var(--space-10) var(--space-8);
  }
  .footer--dark {
    background: var(--color-ink);
    border-top-color: var(--color-border-strong);
  }
  .footer__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .footer__logo img {
    height: 26px;
    width: auto;
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .footer__links a {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-medium);
    color: var(--color-neutral-600);
  }
  .footer--dark .footer__links a {
    color: var(--color-on-dark-muted);
  }
  .footer__links a:hover {
    color: var(--color-ink);
  }
  .footer--dark .footer__links a:hover {
    color: #fff;
  }
  .footer__copy {
    font-family: var(--font-body);
    font-size: 13px;
    /* Original build used --color-neutral-300 (#a0a0a0) on white — ~2.3:1, fails WCAG AA.
       neutral-600 (#4a4a4a) clears 4.5:1 while keeping the same restrained weight. */
    color: var(--color-neutral-600);
    margin: 0;
  }
  .footer--dark .footer__copy {
    color: var(--color-on-dark-muted);
  }
</style>
