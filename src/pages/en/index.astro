---
import BaseLayout from '../../layouts/BaseLayout.astro';

const heroSectors = [
  { name: 'AGRICULTURE', src: '/media/palm-main.mp4', poster: '/media/posters/palm-main.jpg' },
  { name: 'AG-INPUT COMPANIES', src: '/media/agro-field.mp4', poster: '/media/posters/agro-field.jpg' },
  { name: 'MINING', src: '/media/mining.mp4', poster: '/media/posters/mining.jpg' },
  { name: 'FOOD COMPANIES', src: '/media/food.mp4', poster: '/media/posters/food.jpg' },
  { name: 'BANKING & INSURANCE', src: '/media/banking.mp4', poster: '/media/posters/banking.jpg' },
  { name: 'ENVIRONMENT', src: '/media/environment-amazon.mp4', poster: '/media/posters/environment-amazon.jpg' },
];

const countries = ['COLOMBIA', 'PANAMÁ', 'HONDURAS', 'PERÚ', 'CHILE', 'ESPAÑA', 'FRANCIA', 'PORTUGAL'];

const whatItems = [
  'Identifies the environment, digitizes processes, delivers easy-to-understand results and, working as a team with the client, interprets and designs winning actions.',
  'Generates predictive models as decision-support tools.',
  'Supports your Sustainability indicators.',
  'Adds value to your business through Circular Economy advisory.',
  'Measures, analyzes and reports your Carbon Footprint following international standards.',
  'We support the traceability required in Carbon Markets.',
];

const problems = [
  'Detects crop stress before it is visible, reducing yield losses.',
  'Identifies the factors limiting productivity: water, nutrition, temperature, radiation and soil.',
  'Optimizes the use of fertilizers, water and bio-inputs, improving efficiency and reducing costs.',
  'Scientifically evaluates the response of varieties, biostimulants and management strategies.',
  'Turns sensor, drone and physiological monitoring data into practical recommendations through AI.',
  'Quantifies the impact of regenerative practices on soil, productivity and carbon.',
  'Implements MRV systems to measure, report and verify emission reductions and carbon capture.',
  'Generates predictive models to anticipate risks and plan agronomic decisions.',
  'Centralizes scattered information into visual platforms for technical and management use.',
  'Provides scientific evidence to validate technologies, enable certifications and support investment.',
];

const sectors = [
  {
    tag: 'AKAI in AGRICULTURE',
    title: 'Real-time monitoring of crop development',
    desc: 'Proximal sensors that monitor crop development in real time.',
    services: ['Diagnosis', 'Climate forecasting & modeling', 'Digital crop phenotyping'],
    video: '/media/palm-main.mp4',
    poster: '/media/posters/palm-main.jpg',
    link: '/en/case-studies/palm/',
    linkLabel: 'View case study',
  },
  {
    tag: 'AKAI in R&D&I for AG-INPUT COMPANIES',
    title: 'We validate and develop your agricultural innovations',
    desc: 'Field measurement and lab validation: the full arc of scientific evidence.',
    services: ['Solution design', 'Environmental impact assessment', 'Differentiating strategies'],
    video: '/media/agro-field.mp4',
    poster: '/media/posters/agro-field.jpg',
    video2: '/media/agro-lab.mp4',
    link: '/en/case-studies/roots/',
    linkLabel: 'View case study',
  },
  {
    tag: 'AKAI in MINING',
    title: 'From mine soil to a regenerated asset',
    services: ['Mine soil regeneration', 'Waste valorization'],
    video: '/media/mining.mp4',
    poster: '/media/posters/mining.jpg',
  },
  {
    tag: 'AKAI in FOOD COMPANIES',
    title: 'Waste is data too',
    services: ['Waste valorization'],
    video: '/media/food.mp4',
    poster: '/media/posters/food.jpg',
  },
  {
    tag: 'AKAI in BANKING & INSURANCE',
    title: 'Agro-climatic risk, quantified',
    services: ['Risk assessment'],
    video: '/media/banking.mp4',
    poster: '/media/posters/banking.jpg',
  },
  {
    tag: 'AKAI in ENVIRONMENT',
    title: 'Science to restore ecosystems',
    services: ['Revegetation strategies', 'Spatial fragmentation analysis', 'Floristic inventories'],
    video: '/media/environment-amazon.mp4',
    poster: '/media/posters/environment-amazon.jpg',
  },
];
---

<BaseLayout
  lang="en"
  slug=""
  title="AKAI — Applied Data Science and AI"
  description="AKAI S.A.S. is an applied data science and artificial intelligence company for agriculture, ag-inputs, mining, food, banking & insurance, and environment. Science from Colombia, operating worldwide."
>
  <div id="intro-overlay" class="intro" data-intro>
    <script>
      if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('akai_intro_seen')) {
        (document.currentScript as HTMLScriptElement).parentElement?.setAttribute('hidden', '');
      }
    </script>
    <video data-intro-video autoplay muted playsinline class="intro__video" poster="/media/posters/intro-shoots.jpg">
      <source src="/media/intro-shoots.mp4" type="video/mp4" />
    </video>
    <div class="intro__tagline" data-intro-tagline hidden><span>APPLIED · KNOWLEDGE · ARTIFICIAL · INTELLIGENCE</span></div>
    <button type="button" class="intro__skip" data-intro-skip>Skip intro</button>
  </div>

  <section class="hero" data-hero data-hero-sectors={JSON.stringify(heroSectors)}>
    <video
      data-hero-video
      autoplay
      muted
      loop
      playsinline
      class="hero__video"
      poster={heroSectors[0].poster}
      src={heroSectors[0].src}
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__panel hero__panel--desktop" aria-hidden="true">
      <div class="hero__counter" data-hero-counter>01 / 06</div>
      <div class="hero__sector" data-hero-name>{heroSectors[0].name}</div>
    </div>
    <div class="hero__panel hero__panel--mobile" aria-hidden="true">
      <div class="hero__counter" data-hero-counter-mobile>01 / 06</div>
      <div class="hero__sector" data-hero-name-mobile>{heroSectors[0].name}</div>
    </div>

    <div class="hero__content">
      <img src="/assets/akai-logo-white.png" alt="AKAI" class="hero__logo" width="280" height="70" />
      <h1 class="hero__head">We create applied knowledge through AI that optimizes your productivity</h1>
      <p class="hero__sub">
        Data modeling, spatial sciences, remote and proximal sensing, historical and predictive analytics
      </p>
      <div class="hero__ctas">
        <a href="/en/contact/" class="hero__cta-primary">I need more information</a>
        <a href="/en/vision/" class="hero__cta-secondary">
          <span>Vision</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="belief">
    <div class="belief__eyebrow">Our belief</div>
    <h2 class="belief__head">We believe decisions can be predicted, not just monitored.</h2>
    <p class="belief__body">
      Every data point matters. AKAI turns science into metrics that drive actions with forecastable outcomes,
      mitigating impacts on productivity.
    </p>
    <p class="belief__origin">Science from Colombia, operating worldwide.</p>
    <div class="belief__countries">
      {countries.map((c) => <span class="belief__chip">{c}</span>)}
    </div>
    <div class="belief__stats">
      <div class="belief__stat-cell">
        <div class="belief__stat-value">18</div>
        <div class="belief__stat-label">Crops advised</div>
      </div>
      <div class="belief__stat-cell">
        <div class="belief__stat-value">18</div>
        <div class="belief__stat-label">Clients</div>
      </div>
      <div class="belief__stat-cell belief__stat-cell--text">Colombia HQ · Operating worldwide</div>
    </div>
  </section>

  <section class="what">
    <div class="what__inner">
      <h2 class="what__head">Applied data science and artificial intelligence</h2>
      <p class="what__intro">
        AKAI S.A.S. is a data science and artificial intelligence company applied to sectors including agriculture,
        mining, food, banking, insurance, environmental sciences and agricultural inputs. It develops physiological
        monitoring systems, predictive analytics and sustainability quantification to optimize productivity,
        resource-use efficiency and the regeneration of production systems.
      </p>
      <p class="what__summary">
        AKAI turns physiological, environmental and agronomic data into actionable intelligence to increase
        productivity, accelerate regenerative agriculture and support decarbonization.
      </p>
      <div class="what__grid">
        {
          whatItems.map((w) => (
            <div class="what__item">
              <span class="what__marker" aria-hidden="true" />
              <span>{w}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="problems">
    <div class="problems__head">
      <div class="problems__eyebrow">The problems we solve</div>
      <p class="problems__close">
        AKAI turns complex field data into precise decisions that increase productivity, cut costs, reduce risk and
        demonstrate environmental impact.
      </p>
    </div>
    <div class="problems__grid">
      {
        problems.map((p) => (
          <div class="problems__item">
            <span class="problems__marker" aria-hidden="true" />
            <span>{p}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="sectors">
    <h2 class="sectors__label">Sectors</h2>
    {
      sectors.map((s) => (
        <div class="sectors__row">
          <div class="sectors__media">
            <video muted loop playsinline preload="none" data-lazy data-src={s.video} poster={s.poster} class="sectors__video" />
            {s.video2 && (
              <div class="sectors__inset">
                <video muted loop playsinline preload="none" data-lazy data-src={s.video2} class="sectors__video" />
              </div>
            )}
          </div>
          <div class="sectors__body">
            <div class="sectors__tag">{s.tag}</div>
            <h3 class="sectors__title">{s.title}</h3>
            {s.desc && <p class="sectors__desc">{s.desc}</p>}
            <div class="sectors__services">
              {s.services.map((sv) => (
                <span class="sectors__chip">{sv}</span>
              ))}
            </div>
            {s.link && (
              <a href={s.link} class="sectors__link">
                {s.linkLabel} →
              </a>
            )}
          </div>
        </div>
      ))
    }
    <div class="sectors__pending" role="note">
      <span>PENDING — AKAI process slide (client-provided, extract from docx)</span>
    </div>
  </section>
</BaseLayout>

<script src="../../scripts/home.ts"></script>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: #050505;
    transition: opacity 0.8s ease;
  }
  .intro.is-fading {
    opacity: 0;
  }
  .intro.is-done {
    pointer-events: none;
  }
  .intro__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro__tagline {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: clamp(14px, 2.2vw, 22px);
    text-align: center;
    padding: 0 24px;
  }
  .intro__tagline span {
    /* Flex items default to min-width:auto (their unwrapped content width), which stops
       long text from wrapping and lets it overflow the viewport on narrow screens instead.
       min-width:0 restores normal text wrapping inside the flex item. */
    min-width: 0;
  }
  .intro__skip {
    position: absolute;
    bottom: 28px;
    right: 28px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: var(--tracking-wide);
    padding: 10px 18px;
    cursor: pointer;
    border-radius: var(--radius-sharp);
  }

  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    background: var(--color-ink);
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.7) 100%);
    z-index: 1;
  }
  .hero__panel {
    position: absolute;
    z-index: 2;
    text-align: right;
    animation: akaiFadeUp 0.7s ease both;
    background: var(--color-ink);
    border: 1px solid rgba(255, 255, 255, 0.22);
    padding: 14px 20px;
    border-radius: 3px;
  }
  .hero__panel--desktop {
    display: none;
    top: 96px;
    right: 40px;
    max-width: 30vw;
  }
  .hero__panel--mobile {
    bottom: 24px;
    right: 40px;
    max-width: 44vw;
  }
  .hero__counter {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    color: rgba(255, 255, 255, 0.75);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .hero__sector {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(18px, 2.2vw, 30px);
    color: #fff;
    letter-spacing: var(--tracking-wide);
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding: 0 40px 72px;
    max-width: 1020px;
  }
  .hero__logo {
    height: auto;
    width: min(48vw, 560px);
    margin-bottom: var(--space-8);
  }
  .hero__head {
    margin: 0 0 18px;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    font-size: clamp(32px, 5vw, 76px);
    line-height: 1.05;
  }
  .hero__sub {
    margin: 0 0 30px;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(14px, 1.2vw, 18px);
    max-width: 640px;
    line-height: 1.5;
  }
  .hero__ctas {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .hero__cta-primary {
    background: #fff;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 14px;
    padding: 14px 28px;
    border-radius: var(--radius-sharp);
  }
  .hero__cta-secondary {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.28);
    padding: 13px 24px;
    border-radius: var(--radius-sharp);
  }

  @media (min-width: 900px) {
    .hero__panel--desktop {
      display: block;
    }
    .hero__panel--mobile {
      display: none;
    }
  }

  .belief {
    width: 100%;
    padding: 110px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }
  .belief__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .belief__head {
    margin: 0;
    max-width: 940px;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.015em;
    font-size: clamp(28px, 4vw, 54px);
    line-height: 1.16;
  }
  .belief__body {
    margin: 0;
    max-width: 720px;
    color: var(--color-neutral-700);
    font-size: clamp(15px, 1.3vw, 18px);
    line-height: 1.6;
  }
  .belief__origin {
    margin: 0;
    color: var(--color-neutral-500);
    font-size: 14px;
  }
  .belief__countries {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    max-width: 820px;
  }
  .belief__chip {
    padding: 7px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sharp);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .belief__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1px;
    background: var(--color-border-strong);
    border: 1px solid var(--color-border-strong);
    max-width: 900px;
    width: 100%;
    margin-top: 12px;
  }
  .belief__stat-cell {
    background: var(--color-paper);
    padding: 30px 20px;
    text-align: center;
  }
  .belief__stat-cell--text {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(15px, 1.3vw, 18px);
    color: var(--color-ink);
    line-height: 1.4;
  }
  .belief__stat-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 42px);
    color: var(--color-accent);
    line-height: 1;
  }
  .belief__stat-label {
    margin-top: 10px;
    font-size: 13px;
    color: var(--color-neutral-600);
  }

  .what {
    width: 100%;
    padding: 90px 40px;
    background: var(--color-ink);
  }
  .what__inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
  }
  .what__head {
    margin: 0 0 22px;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    font-size: clamp(20px, 2.4vw, 32px);
    line-height: 1.25;
    text-transform: uppercase;
  }
  .what__intro {
    margin: 0 0 18px;
    max-width: 840px;
    color: #c9c9c9;
    font-size: 15px;
    line-height: 1.65;
  }
  .what__summary {
    margin: 0 0 36px;
    max-width: 760px;
    color: var(--color-accent-tint);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(15px, 1.4vw, 19px);
    line-height: 1.45;
  }
  .what__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
  }
  .what__item {
    background: var(--color-ink);
    padding: 26px 24px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: #e6e6e6;
    font-size: 14px;
    line-height: 1.55;
  }
  .what__marker {
    width: 8px;
    height: 8px;
    background: var(--color-accent-tint);
    transform: rotate(45deg);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .problems {
    width: 100%;
    padding: 110px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .problems__head {
    text-align: center;
  }
  .problems__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .problems__close {
    margin: 0;
    max-width: 760px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 32px);
    color: var(--color-ink);
    line-height: 1.3;
  }
  .problems__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background: var(--color-border);
    width: 100%;
  }
  .problems__item {
    background: var(--color-paper);
    padding: 24px 22px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    color: var(--color-neutral-700);
    font-size: 14px;
    line-height: 1.5;
  }
  .problems__marker {
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    transform: rotate(45deg);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .sectors {
    width: 100%;
    padding: 0 40px 110px;
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .sectors__label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .sectors__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    border: 1px solid var(--color-border);
  }
  .sectors__media {
    position: relative;
    min-height: 300px;
    background: var(--color-ink);
    overflow: hidden;
  }
  .sectors__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sectors__inset {
    position: absolute;
    bottom: 14px;
    right: 14px;
    width: 150px;
    height: 96px;
    overflow: hidden;
    padding: 4px;
    background: rgba(10, 10, 10, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 3px;
  }
  .sectors__inset .sectors__video {
    position: static;
    width: 100%;
    height: 100%;
  }
  .sectors__body {
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
    background: var(--color-paper);
  }
  .sectors__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .sectors__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(19px, 1.9vw, 25px);
    color: var(--color-ink);
    line-height: 1.2;
  }
  .sectors__desc {
    margin: 0;
    font-size: 14px;
    color: var(--color-neutral-600);
    line-height: 1.55;
  }
  .sectors__services {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sectors__chip {
    padding: 6px 12px;
    background: var(--color-neutral-100);
    border-radius: var(--radius-sharp);
    font-size: 12px;
    font-weight: 500;
    color: var(--color-neutral-700);
  }
  .sectors__link {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
    margin-top: 4px;
  }
  .sectors__pending {
    border: 1px dashed var(--color-border-strong);
    padding: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    color: var(--color-neutral-400);
    text-transform: uppercase;
    text-align: center;
  }
  .sectors__pending span {
