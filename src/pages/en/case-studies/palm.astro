---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatBlock from '../../../components/StatBlock.astro';
import Badge from '../../../components/Badge.astro';

const stats = [
  { value: '3 months BEFORE', label: 'Actions taken before first symptoms' },
  { value: '300 ha', label: 'Under active monitoring' },
  { value: '20x', label: 'Faster stress detection' },
  { value: '30%', label: 'Disease-risk mitigation' },
];
---

<BaseLayout
  lang="en"
  slug="case-studies/palm"
  title="Palm Oil Case Study — AKAI"
  description="Predicting yield across active palm plantations in Colombia with recurring multispectral drone flights validated by ground sensors."
>
  <section class="hero">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      poster="/media/posters/palm-main.jpg"
      src="/media/palm-main.mp4"
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>

    <div class="hero__inset">
      <video
        class="hero__inset-video"
        autoplay
        muted
        loop
        playsinline
        poster="/media/posters/palm-alt.jpg"
        src="/media/palm-alt.mp4"
      ></video>
      <div class="hero__inset-label">Alt angle</div>
    </div>

    <div class="hero__content">
      <div class="hero__location"><Badge tone="dark">María la Baja, Bolívar, COLOMBIA</Badge></div>
      <div class="hero__eyebrow">Case Study — Palm Oil</div>
      <h1 class="hero__headline">Predicting bud rot, before it happens</h1>
      <p class="hero__subhead">Routine physiological performance assessments are linked to future stress.</p>
    </div>
  </section>

  <section class="details">
    <div class="details__col">
      <h2 class="details__label">The problem</h2>
      <p class="details__body">
        The scale of palm plantations does not allow detecting the degree of physiological stress with enough
        anticipation.
      </p>
    </div>
    <div class="details__col">
      <h2 class="details__label">AKAI solution</h2>
      <p class="details__body">
        Integrating georeferenced field-sensor data to develop AI models that become part of the toolset used to
        make better disease-management decisions.
      </p>
    </div>
  </section>

  <section class="results">
    <h2 class="results__label">Results</h2>
    <StatBlock stats={stats} />
    <p class="results__why">
      At plantation scale, it isn't just a map — it's catching a stressed block early enough to act on
      it, and knowing which hectares to prioritize when resources are limited.
    </p>

    <p class="results__lead">
      BEFORE SYMPTOMS APPEAR, the interaction between the instruments measuring crop metabolism and the
      geopositioning provided by the drone makes it possible to take THE RIGHT decisions.
    </p>

    <div class="disclosure" data-disclosure>
      <button type="button" class="disclosure__trigger" data-disclosure-trigger aria-expanded="false"
        >Read the full story</button
      >
      <div class="disclosure__panel" data-disclosure-panel hidden>
        <p>
          Across the monitored blocks, canopy-level multispectral passes were used to flag stress zones weeks ahead
          of visible symptoms, directing interventions to the hectares that needed them — rather than the whole
          estate.
        </p>
      </div>
    </div>

    <a href="/en/contact/" class="results__cta">I WANT TO CONTACT THEM</a>
  </section>

  <div class="pagenav">
    <a href="/en/case-studies/roots/" class="pagenav__link">
      <span>Greenhouse Trial</span>
      <span class="pagenav__arrow" aria-hidden="true">↓</span>
    </a>
    <a href="/en/" class="pagenav__link">
      <span class="pagenav__arrow" aria-hidden="true">↑</span>
      <span>Back to top</span>
    </a>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--color-ink);
    display: flex;
    align-items: flex-end;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.2) 45%, rgba(0, 0, 0, 0.7) 100%);
    z-index: 1;
  }
  .hero__inset {
    position: absolute;
    bottom: 120px;
    right: var(--space-9);
    width: 260px;
    height: 160px;
    border-radius: var(--radius-sharp);
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
    z-index: 2;
  }
  .hero__inset-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero__inset-label {
    position: absolute;
    bottom: 8px;
    left: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
    text-transform: uppercase;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding: 0 var(--section-padding-x) var(--space-14);
    max-width: 900px;
  }
  .hero__location {
    margin-bottom: var(--space-3);
  }
  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: #fff;
    margin-bottom: var(--space-4);
    text-transform: uppercase;
    opacity: 0.85;
  }
  .hero__headline {
    margin: 0 0 var(--space-5);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
  }
  .hero__subhead {
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: var(--text-body-lg);
    max-width: 560px;
    line-height: var(--leading-normal);
  }

  .details {
    width: 100%;
    padding: 0 var(--section-padding-x);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-10);
    max-width: var(--content-max-width);
    margin: var(--space-14) auto 0;
  }
  .details__label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }
  .details__body {
    margin: 0;
    font-size: var(--text-body);
    color: var(--color-neutral-700);
    line-height: var(--leading-normal);
  }

  .results {
    width: 100%;
    padding: var(--space-11) var(--section-padding-x) var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
  }
  .results__label {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
    margin: 0;
  }
  .results__why {
    max-width: 680px;
    text-align: center;
    font-size: var(--text-body);
    color: var(--color-neutral-700);
    line-height: var(--leading-normal);
    font-weight: var(--weight-medium);
    margin: 0;
  }

  .results__lead {
    max-width: 680px;
    text-align: center;
    font-size: var(--text-body);
    color: var(--color-ink);
    line-height: var(--leading-normal);
    font-weight: var(--weight-semibold);
    margin: 0;
  }

  .disclosure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  .disclosure__trigger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
  }
  .disclosure__panel p {
    max-width: 680px;
    text-align: center;
    font-size: var(--text-body);
    color: var(--color-neutral-700);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .results__cta {
    display: inline-block;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-sharp);
    letter-spacing: var(--tracking-wide);
  }

  .pagenav {
    width: 100%;
    display: flex;
    justify-content: center;
    gap: var(--space-7);
    padding: var(--space-5) 0 var(--space-11);
  }
  .pagenav__link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
  }
  .pagenav__arrow {
    display: inline-block;
    font-size: 18px;
    transform: translateY(1px);
  }
</style>
