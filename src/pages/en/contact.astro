---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dialCodes } from '../../i18n/phone-codes';
---

<BaseLayout
  lang="en"
  slug="contact"
  title="Contact — AKAI"
  description="Talk to the team. See what predictive agronomy looks like on your fields. Request a meeting."
  footerDark={true}
>
  <section class="hero">
    <video
      autoplay
      muted
      loop
      playsinline
      class="hero__video"
      src="/media/cta-aerial.mp4"
      poster="/media/posters/cta-aerial.jpg"
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>
    <p class="hero__note" role="note">
      PENDING — multisector closing video (agriculture, cattle, mining, finance, insurance, climate)
    </p>

    <div class="hero__grid">
      <div class="hero__intro">
        <h1 class="hero__head">Talk to the team.</h1>
        <p class="hero__sub">See what predictive agronomy looks like on your fields.</p>
      </div>

      <div class="hero__panel">
        <form id="contact-form" class="form" data-contact-form>
          <div class="form__field">
            <label for="contact-name" class="form__label">Name</label>
            <input id="contact-name" name="name" type="text" required class="form__input" />
          </div>
          <div class="form__field">
            <label for="contact-email" class="form__label">Email</label>
            <input id="contact-email" name="email" type="email" required class="form__input" />
          </div>
          <div class="form__field">
            <label for="contact-phone" class="form__label">Phone</label>
            <div class="form__phone">
              <select id="contact-dial" name="dialCode" class="form__input form__input--dial" aria-label="Country code">
                {dialCodes.map((c) => <option value={c.code}>{c.code} {c.name}</option>)}
              </select>
              <input id="contact-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" class="form__input" />
            </div>
          </div>
          <div class="form__field">
            <label for="contact-company" class="form__label">Company</label>
            <input id="contact-company" name="company" type="text" class="form__input" />
          </div>
          <div class="form__field">
            <label for="contact-region" class="form__label">Region</label>
            <select id="contact-region" name="region" class="form__input">
              <option value="">Region</option>
              <option value="colombia">Colombia</option>
              <option value="latam">LATAM</option>
              <option value="europe">Europe</option>
              <option value="central-america">Central America</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form__field">
            <label for="contact-message" class="form__label">Message</label>
            <textarea id="contact-message" name="message" rows="4" required class="form__input"></textarea>
          </div>
          <button type="submit" class="form__submit">Request a meeting</button>
        </form>

        <div id="contact-thanks" class="thanks" data-contact-thanks hidden>
          <div class="thanks__title">Thanks — message received.</div>
          <p class="thanks__body">We'll get back to you shortly to schedule a meeting.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const thanks = document.querySelector<HTMLElement>('[data-contact-thanks]');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.hidden = true;
    if (thanks) thanks.hidden = false;
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: var(--color-ink);
    display: flex;
    align-items: center;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 1;
  }
  .hero__note {
    position: absolute;
    top: calc(var(--nav-height) + var(--space-5));
    left: 0;
    right: 0;
    margin: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-wide);
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    z-index: 2;
    padding: 0 var(--section-padding-x);
  }
  .hero__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-13)) var(--section-padding-x) var(--space-13);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-10);
  }
  .hero__head {
    margin: 0 0 var(--space-4);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    font-size: var(--text-h1);
    line-height: 1.08;
  }
  .hero__sub {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 16px;
    line-height: 1.55;
    max-width: 420px;
  }
  .hero__panel {
    align-self: start;
  }

  .form {
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .form__phone {
    display: flex;
    gap: var(--space-2);
  }
  .form__phone .form__input {
    min-width: 0; /* let the tel input shrink instead of overflowing the panel */
  }
  .form__input--dial {
    flex: 0 0 8.5rem;
  }
  .form__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .form__input {
    padding: 12px 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sharp);
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-ink);
    background: var(--color-paper);
  }
  textarea.form__input {
    resize: vertical;
  }
  .form__submit {
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: 14px;
    padding: 14px 24px;
    border: none;
    border-radius: var(--radius-sharp);
    cursor: pointer;
  }

  .thanks {
    background: var(--color-paper);
    border: 1px solid var(--color-border-strong);
    padding: var(--space-8);
  }
  .thanks__title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: 20px;
    margin-bottom: var(--space-3);
    color: var(--color-ink);
  }
  .thanks__body {
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-neutral-600);
    line-height: 1.5;
  }
</style>
