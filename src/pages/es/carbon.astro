---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es"
  slug="carbon"
  title="Carbono — AKAI"
  description="Infraestructura de datos para lo que viene después del rendimiento. Los mismos vuelos y sensores que pronostican el rendimiento generan la capa de medición que los programas de carbono necesitan. En desarrollo."
  noindex={true}
>
  <section class="hero">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      src="/media/carbon-satellite.mp4"
      poster="/media/posters/carbon-satellite.jpg"
    ></video>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__content">
      <span class="hero__badge">MEDICIÓN — REPORTE — VERIFICACIÓN</span>
      <h1 class="hero__headline">Infraestructura de datos para lo que viene después del rendimiento.</h1>
      <p class="hero__body">
        Los mismos vuelos y sensores que pronostican el rendimiento también generan la capa de medición que los
        programas de captura de carbono necesitan (MRV).
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    background: var(--color-ink);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 760px;
    text-align: center;
    padding: 0 40px;
  }
  .hero__badge {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-sharp);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: #fff;
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }
  .hero__headline {
    margin: 0 0 20px;
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    font-size: clamp(28px, 4vw, 54px);
    line-height: 1.15;
  }
  .hero__body {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
  }
</style>
