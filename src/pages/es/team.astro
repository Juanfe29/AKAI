---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatBlock from '../../components/StatBlock.astro';

const disciplines = [
  'Ingenieros electrónicos',
  'Ingenieros de datos',
  'Ingenieros de sistemas',
  'Ingenieros agrónomos',
  'Biólogos',
  'Fisiólogos',
  'Geólogos',
  'Economistas',
];

// Only these two roles are filled in in the source content — the rest of the
// team roster has not been provided yet, so no additional placeholder cards
// are invented here.
const members = [
  { name: 'I.A. PhD Diego Felipe Conejo Rodríguez', role: 'CEO', photo: '/assets/team/diego-conejo.jpg' },
  { name: 'I.A. Héctor Estrada', role: 'Líder de gestión operativa', photo: '/assets/team/hector-estrada.jpg' },
];

const specialties = [
  'BIG DATA',
  'INTELIGENCIA ARTIFICIAL',
  'FISIOLOGÍA DE CULTIVOS',
  'SUELOS',
  'FENOTIPADO DIGITAL',
  'GENÓMICA',
  'AGRONOMÍA POR CULTIVO',
  'CLIMATOLOGÍA AGRÍCOLA',
  'INTERNET DE LAS COSAS',
  'SENSORES',
];

const experience = [
  { value: '10 años', label: 'Manejo de datos' },
  { value: '20 años', label: 'Fisiología de cultivos' },
  { value: '12 años', label: 'Fenotipado digital' },
  { value: '40 años', label: 'Agronomía por especialidad' },
];
---

<BaseLayout
  lang="es"
  slug="team"
  title="Equipo — AKAI"
  description="El equipo interdisciplinario de AKAI: ingeniería, biología, agronomía y ciencia de datos aplicada al servicio de sus decisiones."
>
  <section class="hero">
    <div class="hero__inner">
      <h1 class="hero__head">Equipos INTERDISCIPLINARIOS que soportan sus decisiones:</h1>
      <div class="hero__chips">
        {disciplines.map((d) => <span class="hero__chip">{d}</span>)}
      </div>
    </div>
  </section>

  <section class="members">
    <h2 class="visually-hidden">Equipo</h2>
    <div class="members__grid">
      {
        members.map((m) => (
          <div class="members__card">
            <img class="members__avatar" src={m.photo} alt={m.name} width="120" height="120" loading="lazy" />
            <h3 class="members__name">{m.name}</h3>
            <div class="members__role">{m.role}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="specialties">
    <h2 class="specialties__label">Especialidades del equipo</h2>
    <div class="specialties__grid">
      {specialties.map((sp) => <div class="specialties__cell">{sp}</div>)}
    </div>
  </section>

  <section class="experience">
    <h2 class="experience__label">Experiencia acumulada</h2>
    <StatBlock stats={experience} />
  </section>

  <section class="closing">
    <p class="closing__text">
      La base de una buena IA radica en el conocimiento y en el enfoque adecuado para solucionar cada reto.
    </p>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    width: 100%;
    padding: calc(var(--nav-height) + var(--space-13)) var(--section-padding-x) var(--space-8);
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .hero__inner {
    max-width: 860px;
  }
  .hero__head {
    margin: 0 0 var(--space-5);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    font-size: var(--text-h2);
    line-height: var(--leading-snug);
  }
  .hero__chips {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .hero__chip {
    padding: 7px 14px;
    background: var(--color-neutral-100);
    border-radius: var(--radius-sharp);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-medium);
    color: var(--color-neutral-700);
  }

  .members {
    width: 100%;
    padding: var(--space-9) var(--section-padding-x) var(--space-5);
    display: flex;
    justify-content: center;
  }
  .members__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-6);
    max-width: 700px;
    width: 100%;
  }
  .members__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-5);
    border: 1px solid var(--color-border-strong);
  }
  .members__avatar {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-round);
    border: 1px solid var(--color-border-strong);
    background: var(--color-neutral-100);
    object-fit: cover;
    object-position: center top;
  }
  .members__name {
    margin: 0;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: var(--weight-semibold);
    color: var(--color-ink);
    text-align: center;
  }
  .members__role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-accent);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .specialties {
    width: 100%;
    padding: var(--space-11) var(--section-padding-x) var(--space-5);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  .specialties__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
  }
  .specialties__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    background: var(--color-border);
    max-width: var(--content-max-width);
    width: 100%;
  }
  .specialties__cell {
    background: var(--color-paper);
    padding: var(--space-6) var(--space-4);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink);
    text-transform: uppercase;
  }

  .experience {
    width: 100%;
    padding: var(--space-11) var(--section-padding-x) var(--space-9);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }
  .experience__label {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    color: var(--color-accent);
    text-transform: uppercase;
  }

  .closing {
    width: 100%;
    padding: var(--space-7) var(--section-padding-x) var(--space-15);
    display: flex;
    justify-content: center;
    text-align: center;
  }
  .closing__text {
    margin: 0;
    max-width: 720px;
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h3);
    color: var(--color-ink);
    line-height: 1.35;
  }
</style>
